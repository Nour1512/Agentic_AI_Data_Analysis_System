# =========================================================
# Copy this file to ".env" and adjust the values for your
# local machine. Never commit your real ".env" file.
# =========================================================

# ---------------------------------------------------------
# MongoDB (staging database that holds the generated CSVs)
# ---------------------------------------------------------
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=egyptian_ecommerce

# ---------------------------------------------------------
# SQL Server (final relational data warehouse)
# ---------------------------------------------------------
# Name of the ODBC driver installed on your machine.
# Run `python -c "import pyodbc; print(pyodbc.drivers())"` to list installed drivers.
SQLSERVER_DRIVER=ODBC Driver 17 for SQL Server

# Host/instance name. Use "localhost", "localhost\\SQLEXPRESS", an IP, etc.
SQLSERVER_HOST=localhost

# Leave empty to use the driver default port (1433 for a default instance).
SQLSERVER_PORT=

# Name of the target database. Created automatically if it doesn't exist.
SQLSERVER_DATABASE=egyptian_ecommerce_dw

# "yes" -> use Windows Authentication (trusted connection), ignores USER/PASSWORD below.
# "no"  -> use SQL Server Authentication with SQLSERVER_USER / SQLSERVER_PASSWORD.
SQLSERVER_TRUSTED_CONNECTION=yes
SQLSERVER_USER=
SQLSERVER_PASSWORD=

MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=your_database_name
MYSQL_PORT=3306

GROQ_API_KEY=your_groq_api_key_here
